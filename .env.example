# Copy to .env.local and fill in. Never commit real secrets.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key - safe for the browser, RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service_role) key - server only. Required to run the credit functions.
SUPABASE_SECRET_KEY=

# Google OAuth for local `supabase start` (hosted projects: set in the dashboard)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Stripe (test mode keys while developing) --------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=gbp
# Optional: real Price IDs. When empty, Checkout uses inline prices from src/lib/plans.ts.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_TOPUP_5=
STRIPE_PRICE_TOPUP_10=
STRIPE_PRICE_TOPUP_25=

# PRD 3.3.A: carry unused monthly credits into the next period? (top-ups never expire)
SUBSCRIPTION_CREDIT_ROLLOVER=false

# --- Paint data providers (Adapter Pattern) ----------------------------------
# Failover order, comma separated. Registered: mock-primary, mock-backup, example-http
PAINT_API_PROVIDERS=mock-primary,mock-backup
PAINT_API_TIMEOUT_MS=10000
MOCK_PAINT_API_LATENCY_MS=600
# EXAMPLE_PAINT_API_URL=
# EXAMPLE_PAINT_API_KEY=

# --- Rate limiting (optional; in-memory fallback when empty) -----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron safety net (Vercel Cron sends this as a Bearer token) ---------------
CRON_SECRET=

# --- Automated tests only: point the Stripe SDK at stripe-mock. Leave unset in production.
# STRIPE_API_BASE=http://localhost:12111
